{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "vector_db/Dockerfile",
    "watchPatterns": ["vector_db/**"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/v2/heartbeat",
    "healthcheckTimeout": 120
  }
}
