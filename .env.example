# =============================================================
# LogisticAI - variabili d'ambiente
# Copiare in .env e compilare. Il file .env NON va mai committato.
# =============================================================

# --- LLM (orchestratore) ---
LLM_PROVIDER=openai                  # openai | anthropic | google | mistral | local
LLM_MODEL=
LLM_REGION=                          # es. europe-west8 (Vertex), eu-central-1 (Bedrock)
LLM_BASE_URL=                        # es. endpoint Azure OpenAI o Ollama

# --- LLM (data agent) ---
DATA_LLM_PROVIDER=openai
DATA_LLM_MODEL=

# --- Embedding ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Chiavi provider (compilare solo quelle usate) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
MISTRAL_API_KEY=
AWS_REGION=

# --- Auth ---
JWT_SECRET=                          # stringa casuale lunga (min 32 caratteri)
JWT_EXPIRES_IN=8h
INTERNAL_SERVICE_SECRET=             # segreto condiviso backend <-> data agent (min 32 caratteri)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_USERNAME=sara.operatrice
SEED_OPERATOR_PASSWORD=

# --- Database ---
DATABASE_URL="file:./prisma/dev.db"   # relativo alla cartella backend/

# --- Costi e privacy ---
USD_EUR_RATE=0.92
DAILY_BUDGET_EUR=5
MONTHLY_BUDGET_EUR=50
CHAT_RETENTION_DAYS=180

# --- Servizi ---
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATA_AGENT_URL=http://127.0.0.1:8001
DATA_AGENT_PORT=8001
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=kb_padana
RAG_MAX_DISTANCE=0.65                # oltre questa distanza coseno un documento non è pertinente
CSV_PATH=../data/spedizioni.csv
